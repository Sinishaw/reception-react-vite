rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is an authenticated receptionist
    function isReceptionist() {
      return request.auth != null;
    }

    // Rules for Stations
    match /stations/{stationId} {
      allow read: if true;
      allow create: if isReceptionist() || (
        request.resource.data.activeSession.pairedTabletId != null
      );
      allow update: if isReceptionist() || (
        (resource.data.activeSession.pairedTabletId == null || 
         resource.data.activeSession.pairedTabletId == request.resource.data.activeSession.pairedTabletId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'activeSession', 'lastUpdated'])
      );
      allow delete: if isReceptionist();
    }

    // Rules for Activity Logs
    match /activityLogs/{logId} {
      allow create: if true;
      allow read: if isReceptionist();
    }

    // Rules for Visits
    match /visits/{visitId} {
      allow read, create, update: if true;
      allow delete: if isReceptionist();
    }

    // Rules for Appointments
    match /appointments/{appointmentId} {
      allow read, create, update: if true;
      allow delete: if isReceptionist();
    }

    // Rules for Staff Members
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isReceptionist();
    }
  }
}
